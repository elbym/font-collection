---
permalink: "../src/scss/_includes/_html_colornames.scss"
---
{# Generate a color values from site.js #}
{# the default #}

// Auto-generated by _dynamic-colors.njk — do not edit SCSS file.

.{{ site.color | slugify }}, a.{{ site.color | slugify }}:visited {color: color-mix(in oklab, {{ site.color }}, var(--color-mix-light) 20%);}
.bg-{{ site.color | slugify }} {background-color: color-mix(in oklab, {{ site.color }}, var(--color-mix-light) 20%);}
{# Generate a list of all used HTML Colornames from meta.yaml files in src/webfonts/**/* #}
{% for folder in fontFolders %}
  {% if folder.color %}
.{{ folder.color | slugify }}, a.{{ folder.color | slugify }}:visited {color: color-mix(in oklab, {{ folder.color }}, var(--color-mix-light) 20%);}
.bg-{{ folder.color | slugify }} {background-color: color-mix(in oklab, {{ folder.color }}, var(--color-mix-light) 20%);}
  {% endif %}
{% endfor %}
