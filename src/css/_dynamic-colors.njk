---
permalink: "../src/scss/_includes/_html_colornames.scss"
---
{# Generate a color values from site.js #}
{# the default #}

// Auto-generated by _dynamic-colors.njk — do not edit SCSS file.

.color-{{ site.color | slugify }}, a.color-{{ site.color | slugify }}:visited {color: color-mix(in oklab, {{ site.color }}, var(--color-mix-light) 5%);}
.bg-{{ site.color | slugify }} {background-color: color-mix(in oklab, {{ site.color }}, var(--color-mix-light) 5%);}
{# Generate a list of all used HTML Colornames from meta.yaml files in src/webfonts/**/* #}
{% for folder in fontFolders %}
  {% if folder.color %}
.color-{{ folder.color | slugify }}, a.color-{{ folder.color | slugify }}:visited {color: color-mix(in oklab, {{ folder.color }}, var(--color-mix-light) 5%);}
.bg-{{ folder.color | slugify }} {background-color: color-mix(in oklab, {{ folder.color }}, var(--color-mix-light) 5%);}
  {% endif %}
{% endfor %}
