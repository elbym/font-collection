---
layout: layouts/base.njk

pagination:
  data: fontFolders
  size: 1
  alias: folder
permalink: "{{ folder.url }}.html"
---
{# ── Breadcrumb ────────────────────────────────────────────── #}
{% set ancestors = folder | getAncestors(fontFolders) %}
{% if ancestors.length %}
  <nav aria-label="Breadcrumb" class="breadcrumb small">
    {% for ancestor in ancestors %}
      <a href="/{{ ancestor.url }}.html">{{ ancestor.title }}</a>
      <span aria-hidden="true">/</span>
    {% endfor %}
    <span aria-current="page">{{ folder.title }}</span>
  </nav>
{% endif %}

{# ── Seiteninhalt ──────────────────────────────────────────── #}
{% set children = folder | getChildNodes(fontFolders) %}

{% if folder.isLeaf %}
  {# Blattknoten: Specimen der eigenen Fonts #}
  {% set prevNext = folder.key | findPrevNext(fontLeaves) %}
  {% include "font-poster.njk" %}

  <nav class="font-nav" aria-label="Schriften-Navigation">
    {% if prevNext.prev %}
      <a href="/{{ prevNext.prev.url }}.html" class="font-nav-prev">← {{ prevNext.prev.title }}</a>
    {% else %}
      <span class="font-nav-prev font-nav--empty"></span>
    {% endif %}
    <a href="/" class="font-nav-home">Übersicht</a>
    {% if prevNext.next %}
      <a href="/{{ prevNext.next.url }}.html" class="font-nav-next">{{ prevNext.next.title }} →</a>
    {% else %}
      <span class="font-nav-next font-nav--empty"></span>
    {% endif %}
  </nav>

{% else %}
  {# Gruppenknoten: Übersicht aller enthaltenen Schriften #}
  <section class="font-list-controls">
    <h2>{{ children | length }} Schriften</h2>
    <div class="sort-filter">
      <div class="sort-buttons" role="group" aria-label="Sortierung">
        <button class="sort-btn is-active" data-sort="default">Standard</button>
        <button class="sort-btn" data-sort="alpha">A–Z</button>
        <button class="sort-btn" data-sort="year-desc">Neueste</button>
        <button class="sort-btn" data-sort="styles-desc">Schnitte</button>
      </div>
      <div class="filter-buttons" role="group" aria-label="Filter">
        <button class="filter-btn is-active" data-filter="">Alle</button>
        <button class="filter-btn filter-btn--special" data-filter="--variable">Variable</button>
        <button class="filter-btn filter-btn--special" data-filter="--italic">Hat Kursiv</button>
        <button class="filter-btn filter-btn--special" data-filter="--family">Große Familie</button>
      </div>
    </div>
  </section>

  <div class="font-family-card-list" id="font-list">
    {% for node in children %}
      {% include "font-card.njk" %}
    {% endfor %}
  </div>

  <script>
  (function () {
    var list = document.getElementById('font-list');
    if (!list) return;
    var cards = Array.from(list.querySelectorAll('.card'));
    var originalOrder = cards.slice();
    var activeSort = 'default';
    var activeFilter = '';

    function apply() {
      var sorted;
      if (activeSort === 'alpha') {
        sorted = cards.slice().sort(function (a, b) { return a.dataset.name.localeCompare(b.dataset.name, 'de'); });
      } else if (activeSort === 'year-desc') {
        sorted = cards.slice().sort(function (a, b) {
          return (parseInt(b.dataset.year) || 0) - (parseInt(a.dataset.year) || 0);
        });
      } else if (activeSort === 'styles-desc') {
        sorted = cards.slice().sort(function (a, b) {
          return (parseInt(b.dataset.styles) || 0) - (parseInt(a.dataset.styles) || 0);
        });
      } else {
        sorted = originalOrder;
      }

      sorted.forEach(function (card) {
        var visible;
        if (!activeFilter)                       visible = true;
        else if (activeFilter === '--variable')  visible = card.dataset.variable === 'true';
        else if (activeFilter === '--italic')    visible = card.dataset.italic === 'true';
        else if (activeFilter === '--family')    visible = (parseInt(card.dataset.styles) || 0) >= 8;
        else                                     visible = false;
        card.style.display = visible ? '' : 'none';
        list.appendChild(card);
      });
    }

    document.querySelectorAll('.sort-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        document.querySelectorAll('.sort-btn').forEach(function (b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
        activeSort = btn.dataset.sort;
        apply();
      });
    });

    document.querySelectorAll('.filter-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        document.querySelectorAll('.filter-btn').forEach(function (b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
        activeFilter = btn.dataset.filter;
        apply();
      });
    });
  })();
  </script>
{% endif %}
