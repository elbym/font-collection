---
layout: layouts/base.njk

pagination:
  data: fontFolders
  size: 1
  alias: folder
permalink: "{{ folder.url }}.html"
---

{# ── Rekursives Navigationsmakro ───────────────────────────── #}
{% macro navTree(nodes, fontFolders, currentFolder) %}
  <ul>
    {% for node in nodes %}
      {% set children = node | getChildNodes(fontFolders) %}
      {% set isActive  = (node.path == currentFolder.path) %}
      {% set isAncestor = node | isAncestorOf(currentFolder) %}
      <li class="
        {%- if isActive %} is-active{%- endif %}
        {%- if isAncestor %} is-ancestor{%- endif %}
        {%- if children.length %} has-children{%- endif %}
      ">
        <a href="/{{ node.url }}.html"
          {% if isActive %}aria-current="page"{% endif %}
          {% if node.color %}style="--nav-accent: {{ node.color }}"{% endif %}>
          {{ node.title }}
        </a>
        {% if children.length and (isActive or isAncestor) %}
          {{ navTree(children, fontFolders, currentFolder) }}
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% endmacro %}

{# ── Breadcrumb ────────────────────────────────────────────── #}
{% set ancestors = folder | getAncestors(fontFolders) %}
{% if ancestors.length %}
  <nav aria-label="Breadcrumb" class="breadcrumb small">
    {% for ancestor in ancestors %}
      <a href="/{{ ancestor.url }}.html">{{ ancestor.title }}</a>
      <span aria-hidden="true">/</span>
    {% endfor %}
    <span aria-current="page">{{ folder.title }}</span>
  </nav>
{% endif %}

