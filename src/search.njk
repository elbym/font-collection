---

<h1>Schriften suchen</h1>

<style>
  #search {
    --pagefind-ui-primary: var(--color-accent, #666);
    --pagefind-ui-text: currentColor;
    --pagefind-ui-background: transparent;
    --pagefind-ui-border-radius: 4px;
  }
</style>

<div id="search"></div>

<script src="/pagefind/pagefind-ui.js"></script>
<script>
  window.addEventListener('DOMContentLoaded', function () {
    new PagefindUI({
      element: '#search',
      showImages: false,
      excerptLength: 15,
      translations: {
        placeholder: 'Schrift suchen …',
        zero_results: 'Keine Ergebnisse für „[SEARCH_TERM]”',
        many_results: '[COUNT] Ergebnisse für „[SEARCH_TERM]”',
        one_result: '[COUNT] Ergebnis für „[SEARCH_TERM]”',
        load_more: 'Mehr laden',
        clear_search: 'Löschen',
        searching: 'Suche nach „[SEARCH_TERM]” …',
      }
    });
  });
</script>
