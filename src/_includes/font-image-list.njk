{% if fontImages[folder.key] %}
  <article>
    <ul class="gallery">
      {% for image in fontImages[folder.key] %}
        {# Prüfe, ob es ein Override für diesen Dateinamen gibt #}
        {% set override = folder.imageOverrides[image.filename] if (folder.imageOverrides and folder.imageOverrides[image.filename]) else null %}

        {# Bestimme den Alt-Text: Objekt-Eigenschaft > String-Wert > Standard-Alt #}
        {% set displayAlt = image.alt %}
        {% if override %}
          {% if override.alt %}
            {% set displayAlt = override.alt %}
          {% elif override is string %}
            {% set displayAlt = override %}
          {% endif %}
        {% endif %}

        <li class="gallery-item">
          <figure>
            <img src="{{ image.src }}" alt="{{ displayAlt }}" loading="lazy"
              {% if image.width and image.height %}width="{{ image.width }}" height="{{ image.height }}"{% endif %}>
            <figcaption>
              {% if override.alt %}
                {{ displayAlt }}            {% endif %}

              {% if override.source %}
                <span class="image-source">
                Source: <a href="{{ override.source }}" target="_blank" rel="noopener">{{ override.source | toDomain }}</a></span>
              {% else %}
                {{ image.filename }}
              {% endif %}
            </figcaption>
          </figure>
        </li>
      {% endfor %}
    </ul>
  </article>
{% endif %}