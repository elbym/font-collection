{# Slim bar above the main header. Currently only the theme switch:
   cycles system → light → dark → system (theme-toggle.js). #}
<div class="top-bar" data-pagefind-ignore>
  <button type="button" id="theme-toggle" class="top-bar__theme"
          aria-label="Farbschema wechseln"
          title="Farbschema: System (klicken zum Wechseln)">
    <span data-theme-icon aria-hidden="true">🖥</span>
    <span data-theme-label>System</span>
  </button>
</div>
