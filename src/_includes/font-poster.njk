<main class="specimen-poster border-{{ folder.border | slugify }}">
  <a id="poster"></a>
  {# Fonts für den aktuellen Ordner — kommt jetzt aus dem folder-Objekt der Pagination #}
  {% set activeFonts = folder.ownFonts %}
  {% set _fvAxes = fontVariableAxes[folder.key] %}

  <header class="header">
    {% if folder.tags.length %}
      <ul class="keywords ligatures small">
        {% for tag in folder.tags %}
          <li>
            <a href="/tag/{{ tag | slugify }}.html">{{ tag }}</a>
          </li>
        {% endfor %}
      </ul>

    {% endif %}
    <p class="author">{{ folder.fontauthor }}</p>
    <h1 class="ligatures display-size-5">
      <span id="fonttitle">{{ folder.title }}</span></h1>
    <p class="year">{{ folder.fontyear }}</p>

    {% if folder.license %}
      <section class="font-meta-footer">
        <article class="font-meta-footer__inner">
          <dl class="font-meta-dl">
            <dt>Lizenz</dt>
            <dd>{{ folder.license }}</dd>
          </dl>
        </article>
      </section>
    {% endif %}

    {% if folder.sourceUrl %}
      <p>
        <a href="{{ folder.sourceurl }}" class="small" target="_blank" rel="noopener noreferrer">{{ folder.sourceUrl }}</a>
      </p>
    {% endif %}
    {% if folder.wikipedia %}
      <p>
        <a href="{{ folder.wikipedia }}" class="small" target="_blank" rel="noopener noreferrer">Wikipedia</a>
      </p>
    {% endif %}
    {% if folder.comment %}
      <article class="comment">
        <p>{{ folder.comment }}</p>
      </article>
    {% endif %}

    {% if folder.content %}
      <article class="font-content">
        {{ folder.content | markdownify | safe }}
      </article>
    {% endif %}

  </header>

  <section class="hero">
    <article class="hero_grid">
      <article class="letters">
        <p class="fitty">Aa Rr Ee</p>
        <p class="fitty italic">Aa Rr Ee</p>
      </article>

      <article class="hero-letters">
        <div class="cmyk">
          <div class="cmyk-layer cmyk_cyan"></div>
          <div class="cmyk-layer cmyk_magenta"></div>
          <div class="cmyk-layer cmyk_yellow"></div>
          <div class="cmyk-layer cmyk_black"></div>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="cmyk-mask">
          <defs>
            <clippath id="text-clip">
              <text class="big" x="50%" y="0" text-anchor="middle" dominant-baseline="central">
                {{ folder.heroletter or site.heroletter }}
              </text>
            </clippath>
          </defs>
        </svg>
      </article>

      <article class="hero-word">
        <p class="display-size-6 {% if folder.herostyle %}{{ folder.herostyle }}{% endif %} ligatures {% if folder.color %}{{ folder.color | slugify }}{% endif %}" data-var-preview>
          {{ folder.heroword or site.heroword }}
        </p>
        {% if _fvAxes %}
          <div class="var-font-sliders">
            {% for axisTag, axisData in _fvAxes %}
              <div class="var-axis-row">
                <span class="var-axis-label">{{ axisData.name }}</span>
                <input class="var-axis-range"
                   type="range"
                   min="{{ axisData.min }}"
                   max="{{ axisData.max }}"
                   step="{{ axisData.step }}"
                   value="{{ axisData.default }}"
                   data-axis="{{ axisTag }}"
                   aria-label="{{ axisData.name }}">
                <output class="var-axis-output">{{ axisData.default }}</output>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </article>

      <article class="alphabet">
        <div class="alphabet_letters upper">
          {% for char in "abc_upper" | unicodeChars %}
            <span>{{ char }}</span>
          {% endfor %}
        </div>
        <div class="alphabet_letters">
          {% for char in "abc_lower" | unicodeChars %}
            <span>{{ char }}</span>
          {% endfor %}
        </div>
        <div class="alphabet_letters numbers old-nums">
          {% for char in "digits" | unicodeChars %}
            <span>{{ char }}</span>
          {% endfor %}
          {% for char in "punctuation" | unicodeChars %}
            <span>{{ char }}</span>
          {% endfor %}
        </div>
      </article>
    </article>

    {% set varFonts = activeFonts | selectattr("isVariable") | list %}
    {% set waterfallFonts = varFonts if varFonts | length > 0 else
      activeFonts %}

    {% if activeFonts %}
      {% set hasItalic = waterfallFonts | selectattr("variantGroup", "equalto", "Italic") | list | length > 0 %}
      {% set waterfallGroups = ["Regular", "Italic"] if hasItalic else
        ["Regular"] %}

      <article class="waterfall--styles">
        {% set waterfallText = "" %}
        {% include "waterfall-groups.njk" %}
      </article>

    {% endif %}

    {% if fontImages[folder.key] %}{% include "font-image-list.njk" %}
    {% endif %}

    <article class="latin">
      {% set displayFont = null %}
      {% for f in activeFonts %}
        {% if f.optical == 'Display' and not displayFont %}
          {% set displayFont = f %}
        {% endif %}
      {% endfor %}

      <p class="upper">Specimen</p>
      <p class="upper fitty">Character <span class="small-caps">VM</span> sev</p>
      {% if displayFont %}
        <p class="display-size-5 small-caps fitty"
                  style="font-family: '{{ displayFont.family }} {{ displayFont.optical }}';">
                  Also in Display weight
                </p>
      {% endif %}
      <p class="upper italic fitty">Typorum probatissimorum,</p>
      <p class="fitty bold">Incondite qvidem, <span class="italic">sed secundum,</span></p>
      <p class="upper fitty">svas tamen differentias propositum</p>
    </article>

  </section>

  <section class="paragraph-blocks">
    <article>
      {% for size in[
        28,
        24,
        20,
        16,
        12,
        8
      ] %}
        <p class="font-size-{{ size }} justify initials">
          {# <span>Size: {{ size }}px</span> #}
          {{ site["paragraph" + size] }}
        </p>
      {% endfor %}

    </article>

  </section>

  {% if activeFonts %}
    {% set _wfFamily = activeFonts[0].family %}

    {% if _fvAxes %}
      {# Variable Font: eine Wasserfall-Sektion pro Achse mit echten Werten aus fontkit #}
      {% for axisTag, axisData in _fvAxes %}
        <section class="waterfall waterfall--axis waterfall--axis-{{ axisTag }}">
          {% include "seperator.njk" %}
          <article>
            <h2>{{ folder.title }} — {{ axisData.name }}</h2>
            <article class="waterfall-group waterfall-group--{{ axisTag }}">
              {% for step in axisData.steps %}
                <p style="font-family: '{{ _wfFamily }}'; {{ step.style }};">{{ site.panagram }}</p>
              {% endfor %}
            </article>
          </article>
        </section>
      {% endfor %}

    {% else %}
      {# Statische Schrift: gewohnter Gewichts-Wasserfall #}
      {% set waterfallGroups = null %}
      <section class="waterfall waterfall--panagram">
        {% include "seperator.njk" %}
        <article>
          <h2>{{ folder.title }} Family</h2>
          {% set waterfallText = site.panagram %}
          {% include "waterfall-groups.njk" %}
        </article>
      </section>
    {% endif %}

  {% else %}
    <p>Keine Schriften im Ordner „{{ folder.title }}" gefunden.</p>
  {% endif %}

  {# ── Verwandte Schriften ─────────────────────────────────────────── #}
  {% set relatedFonts = folder | findRelated(fontLeaves, 12) %}
  {% if relatedFonts.length > 0 %}
    <section class="related-fonts">
      <h2 class="related-fonts__heading">Verwandte Schriften</h2>
      <ul class="related-fonts__list">
        {% for leaf in relatedFonts %}
          <li>
            <a class="related-fonts__link font-{{ leaf.key | slugify }}"
               href="/{{ leaf.url }}.html"
               style="--related-color: {{ leaf.color or 'currentColor' }};">
              <span class="related-fonts__name">{{ leaf.title }}</span>
              <span class="related-fonts__tags">
                {%- for tag in leaf.tags -%}
                  {%- if tag in folder.tags -%}
                    <em>{{ tag }}</em>
                  {%- else -%}
                    {{ tag }}
                  {%- endif -%}
                  {%- if not loop.last %}, {% endif -%}
                {%- endfor -%}
              </span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {%- set cpMap = fontCodepoints[folder.key] if fontCodepoints else null -%}
  <section class="ascii">
    <article>
      {% for section in unicodeRanges %}
        <h2>{{ section.label }}
          {% if cpMap %}
            <span class="coverage">({{ section.key | coveragePercent(cpMap) }}%)</span>{% endif %}
        </h2>
        {% for char in section.key | unicodeChars %}
          <span class="l{% if cpMap and not cpMap[char | charCodeAt] %} char--missing{% endif %}">{{ char }}</span>
        {% endfor %}
      {% endfor %}
    </article>
  </section>

</main>

<script>
  (function () {
    // Variable Font Sliders
    var preview = document.querySelector('[data-var-preview]');
    if (!preview)
      return;

    var axisValues = {};

    function applyAxes() {
      var fvs = Object
        .entries(axisValues)
        .filter(function (e) {
          return e[0] !== 'wght' && e[0] !== 'wdth';
        })
        .map(function (e) {
          return "'" + e[0] + "' " + e[1];
        });

      if (fvs.length > 0) {
        preview.style.fontVariationSettings = fvs.join(', ');
      }
      if (axisValues['wght'] !== undefined) {
        preview.style.fontWeight = axisValues['wght'];
      }
      if (axisValues['wdth'] !== undefined) {
        preview.style.fontStretch = axisValues['wdth'] + '%';
      }
    }

    var inputs = Array.from(document.querySelectorAll('.var-axis-range'));
    var animFrame = null;
    var startTime = null;

    inputs.forEach(function (input) {
      axisValues[input.dataset.axis] = parseFloat(input.value);
    });

    // Manual input handler (active after user takes over)
    inputs.forEach(function (input) {
      input.addEventListener('input', function () {
        var val = parseFloat(input.value);
        axisValues[input.dataset.axis] = val;
        var output = input.nextElementSibling;
        if (output)
          output.value = Math.round(val * 10) / 10;
        applyAxes();
      });
    });

    // Auto-animation
    function animate(timestamp) {
      if (!startTime)
        startTime = timestamp;
      var t = (timestamp - startTime) / 1000;

      inputs.forEach(function (input, i) {
        var min = parseFloat(input.min);
        var max = parseFloat(input.max);
        var mid = (min + max) / 2;
        var amp = (max - min) / 2;
        // Each axis gets a distinct phase and a gentle speed
        var phase = i * (Math.PI * 2 / 3);
        var speed = 0.08 + i * 0.04;
        var val = mid + amp * Math.sin(t * speed * Math.PI * 2 + phase);
        var step = parseFloat(input.step) || 1;
        val = Math.round(val / step) * step;
        val = Math.max(min, Math.min(max, val));
        input.value = val;
        var output = input.nextElementSibling;
        if (output)
          output.value = Math.round(val * 10) / 10;
        axisValues[input.dataset.axis] = val;
      });

      applyAxes();
      animFrame = requestAnimationFrame(animate);
    }

    function stopAnimation() {
      if (animFrame) {
        cancelAnimationFrame(animFrame);
        animFrame = null;
      }
    }

    inputs.forEach(function (input) {
      input.addEventListener('mousedown', stopAnimation);
      input.addEventListener('touchstart', stopAnimation, {passive: true});
      input.addEventListener('keydown', stopAnimation);
    });

    animFrame = requestAnimationFrame(animate);
  })();
</script>