<main class="specimen-poster border-{{ folder.border | slugify }}">
<a id="poster"></a>
  {# Fonts für den aktuellen Ordner — kommt jetzt aus dem folder-Objekt der Pagination #}
  {% set activeFonts = folder.ownFonts %}

  <header class="header">
    {% if folder.tags.length %}
      <ul class="keywords ligatures small">
        {% for tag in folder.tags %}
          <li>
            <a href="/tag/{{ tag | slugify }}.html">{{ tag }}</a>
          </li>
        {% endfor %}
      </ul>

    {% endif %}
    <p class="author">{{ folder.fontauthor }}</p>
    <h1 class="ligatures display-size-5">
      <span id="fonttitle">{{ folder.title }}</span></h1>
    <p class="year">{{ folder.fontyear }}</p>
    {% if folder.sourceUrl %}
      <p>
        <a href="{{ folder.sourceUrl }}" class="small" target="_blank" rel="noopener">{{ folder.sourceUrl }}</a>
      </p>
    {% endif %}
    {% if folder.wikipedia %}
      <p>
        <a href="{{ folder.wikipedia }}" class="small" target="_blank" rel="noopener">Wikipedia</a>
      </p>
    {% endif %}
    {% if folder.comment %}
      <article class="comment">
        <p>{{ folder.comment }}</p>
      </article>
    {% endif %}

    {% if folder.content %}
      <article class="font-content">
        {{ folder.content | markdownify | safe }}
      </article>
    {% endif %}

  </header>

  <section class="hero">
    <article class="hero_grid">
      <article class="letters">
        <p class="fitty">Aa Rr Ee</p>
        <p class="fitty italic">Aa Rr Ee</p>
      </article>

      <article class="hero-letters">
        <div class="cmyk">
          <div class="cmyk-layer cmyk_cyan"></div>
          <div class="cmyk-layer cmyk_magenta"></div>
          <div class="cmyk-layer cmyk_yellow"></div>
          <div class="cmyk-layer cmyk_black"></div>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="cmyk-mask">
          <defs>
            <clippath id="text-clip">
              <text class="big" x="50%" y="0" text-anchor="middle" dominant-baseline="central">
                {{ folder.heroletter or site.heroletter }}
              </text>
            </clippath>
          </defs>
        </svg>
      </article>

      <article class="hero-word">
        <p class="display-size-6 {% if folder.herostyle %}{{ folder.herostyle }}{% endif %} ligatures {% if folder.color %}{{ folder.color | slugify }}{% endif %}">
          {{ folder.heroword or site.heroword }}
        </p>
      </article>

      <article class="alphabet">
        <div class="alphabet_letters upper">
          {% for char in "abc_upper" | unicodeChars %}
            <span>{{ char }}</span>
          {% endfor %}
        </div>
        <div class="alphabet_letters">
          {% for char in "abc_lower" | unicodeChars %}
            <span>{{ char }}</span>
          {% endfor %}
        </div>
        <div class="alphabet_letters numbers old-nums">
          {% for char in "digits" | unicodeChars %}
            <span>{{ char }}</span>
          {% endfor %}
          {% for char in "punctuation" | unicodeChars %}
            <span>{{ char }}</span>
          {% endfor %}
        </div>
      </article>
    </article>

    {% set varFonts = activeFonts | selectattr("isVariable") | list %}
    {% set waterfallFonts = varFonts if varFonts | length > 0 else activeFonts %}

    {% if activeFonts %}
      {% set waterfallGroups = ["Regular", "Italic"] %}

        <article class="waterfall--styles">
          {% set waterfallText = "" %}
          {% include "waterfall-groups.njk" %}
        </article>

    {% endif %}

    {% if fontImages[folder.key] %}{% include "font-image-list.njk" %}{% endif %}

    <article class="latin">
      {% set displayFont = null %}
      {% for f in activeFonts %}
        {% if f.optical == 'Display' and not displayFont %}
          {% set displayFont = f %}
        {% endif %}
      {% endfor %}

      <p class="upper">Specimen</p>
      <p class="upper fitty">Character <span class="small-caps">VM</span> sev</p>
      {% if displayFont %}
        <p class="display-size-5 small-caps fitty"
                  style="font-family: '{{ displayFont.family }} {{ displayFont.optical }}';">
                  Also in Display weight
                </p>
      {% endif %}
      <p class="upper italic fitty">Typorum probatissimorum,</p>
      <p class="fitty bold">Incondite qvidem, <span class="italic">sed secundum,</span></p>
      <p class="upper fitty">svas tamen differentias propositum</p>
    </article>

  </section>

  <section class="paragraph-blocks">
    <article>
      {% for size in[
        28,
        24,
        20,
        16,
        12,
        8
      ] %}
      <p class="font-size-{{ size }} justify initials">
        {# <span>Size: {{ size }}px</span> #}
        {{ site["paragraph" + size] }}
      </p>
      {% endfor %}

    </article>

  </section>

  {% if activeFonts %}
    {% set waterfallGroups = null %}

    <section class="waterfall waterfall--panagram">
      {% include "seperator.njk" %}
      {# -------------------------------------------------------------------------------- #}
      <article>
        <h2>{{ folder.title }} Family</h2>
        {% set waterfallText = site.panagram %}
        {% include "waterfall-groups.njk" %}
      </article>
    </section>

  {% else %}
    <p>Keine Schriften im Ordner „{{ folder.title }}" gefunden.</p>
  {% endif %}

  {%- set cpMap = fontCodepoints[folder.key] if fontCodepoints else null -%}
  <section class="ascii">
    <article>
      {% for section in unicodeRanges %}
        <h2>{{ section.label }}{% if cpMap %} <span class="coverage">({{ section.key | coveragePercent(cpMap) }}%)</span>{% endif %}</h2>
        {% for char in section.key | unicodeChars %}
          <span class="l{% if cpMap and not cpMap[char | charCodeAt] %} char--missing{% endif %}">{{ char }}</span>
        {% endfor %}
      {% endfor %}
    </article>
  </section>

</main>
