<a id="poster"></a>
<div class="specimen-poster">

    <header class="header">
        {% if tags %}
            <ul class="keywords italic ligatures">
                {% for tag in tags %}
                <li>{{ tag }}</li>
                {% endfor %}
            </ul>
        {% endif %}
        <p class="year">{{ fontyear }}</p>
        <p class="author">{{ fontauthor }}</p>
        <h1><span id="fonttitle">{{ title }}</span></h1>
        {% if url %}<p><a href="{{ url }}" class="small" target="_blank" rel="noopener">{{ url }}</a></p>{% endif %}
        {% if comment %}
            <article class="comment"><p>{{ comment }}</p></article>
        {% endif %}
        <svg class="svg_seperator" xmlns="http://www.w3.org/2000/svg" width="358.929" height="11" viewBox="0 0 94.967 2.91"><path d="M35.547 37.418h1.87v1.87h-1.87z" class="line" transform="rotate(-45 -2.564 6.642)"/><path d="m54.24 0 1.322 1.323-1.322 1.323M51.594 2.646 50.27 1.323 51.594 0" class="line" transform="translate(-5.448 .132)"/><path d="M55.592 1.323h44.676" class="line" transform="translate(-5.448 .132)"/><path d="m99.607.661.661.662-.661.661" class="line" transform="translate(-5.448 .132)"/><path d="M5.594 1.323h44.677" class="line" transform="translate(-5.448 .132)"/><path d="m6.242 1.984-.662-.661.662-.662" class="line" transform="translate(-5.448 .132)"/></svg>

    </header>

    <section class="hero">
        <article class="letters">
            <p>Aa Rr Ee</p>
            <p class="italic">Aa Rr Ee</p>
        </article>

        <article class="hero-letters">
            {# <p class="big">{{ heroletter or site.heroletter}}</p> #}
            <div class="cmyk">
                <div class="cmyk-layer cmyk_cyan"></div>
                <div class="cmyk-layer cmyk_magenta"></div>
                <div class="cmyk-layer cmyk_yellow"></div>
                <div class="cmyk-layer cmyk_black"></div>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="cmyk-mask">
                <defs>
                    <clipPath id="text-clip">
                        <text class="big" x="50%" y="0" text-anchor="middle" dominant-baseline="central">
                            {{ heroletter or site.heroletter}}
                        </text>
                    </clipPath>
                </defs>
            </svg>
        </article>

        <article class="hero-word">
            <p contenteditable="true" class="display-size-6 {% if herostyle %}{{ herostyle }}{% endif %} ligatures bold {{ color | slugify }}">{{ heroword or site.heroword }}</p>
        </article>

        <article class="alphabet">
            <div class="alphabet_letters upper">
                {% for i in range(65, 91) %}
                <span>{{ i | chr }}</span>
                {% endfor %}
            </div>
            <div class="alphabet_letters">
                {% for i in range(97, 123) %}
                <span>{{ i | chr }}</span>
                {% endfor %}
            </div>
            <div class="alphabet_letters numbers old-nums">
                {% for i in range(48, 58) %}
                <span>{{ i | chr }}</span>
                {% endfor %}
                {% for i in range(32, 47) %}
                <span>{{ i | chr }}</span>
                {% endfor %}
            </div>
        </article>
    </section>

    <section class="font-gallery">
        {% include "font-image-list.njk" %}
    </section>

    {# <section class="about-the-font">
        <article>
            {% if aboutthefont %}<p class="initials">{{ aboutthefont }}</p>{% endif %}
            {% if abouttheauthor %}<p>{{ abouttheauthor }}</p>{% endif %}
        </article>
    </section> #}

    <section class="latin">
        <svg class="svg_seperator" xmlns="http://www.w3.org/2000/svg" width="358.929" height="11" viewBox="0 0 94.967 2.91"><path d="M35.547 37.418h1.87v1.87h-1.87z" class="line" transform="rotate(-45 -2.564 6.642)"/><path d="m54.24 0 1.322 1.323-1.322 1.323M51.594 2.646 50.27 1.323 51.594 0" class="line" transform="translate(-5.448 .132)"/><path d="M55.592 1.323h44.676" class="line" transform="translate(-5.448 .132)"/><path d="m99.607.661.661.662-.661.661" class="line" transform="translate(-5.448 .132)"/><path d="M5.594 1.323h44.677" class="line" transform="translate(-5.448 .132)"/><path d="m6.242 1.984-.662-.661.662-.662" class="line" transform="translate(-5.448 .132)"/></svg>

        <article>
            <p class="display-size-3 upper">specimen</p>
            <p class="display-size-5 upper">Chara <span class="small-caps">de</span> sev</p>
            <p class="p-2-col justify initials">{{ heroparagraph or site.heroparagraph }}</p>
            <p class="display-size-4 upper">Typorvm probatissimor,</p>
            <p class="display-size-3">Incondetie qvidem, sed secvn</p>
            <p class="display-size-2 upper">dvm svas tamen differentias pro</p>
            <p class="display-size-1">positvm, tam upsis librorvm avtoribvs</p>
            <p><small>accommodatvm</small></p>
        </article>
    </section>

    <section class="waterfall">
        <svg class="svg_seperator" xmlns="http://www.w3.org/2000/svg" width="358.929" height="11" viewBox="0 0 94.967 2.91"><path d="M35.547 37.418h1.87v1.87h-1.87z" class="line" transform="rotate(-45 -2.564 6.642)"/><path d="m54.24 0 1.322 1.323-1.322 1.323M51.594 2.646 50.27 1.323 51.594 0" class="line" transform="translate(-5.448 .132)"/><path d="M55.592 1.323h44.676" class="line" transform="translate(-5.448 .132)"/><path d="m99.607.661.661.662-.661.661" class="line" transform="translate(-5.448 .132)"/><path d="M5.594 1.323h44.677" class="line" transform="translate(-5.448 .132)"/><path d="m6.242 1.984-.662-.661.662-.662" class="line" transform="translate(-5.448 .132)"/></svg>

        {# Wir holen uns nur die Schriften für den gewählten Ordner aus dem globalen 'fonts' Objekt #}
        {% set activeFonts = fonts[selectedFontFolder] %}

        {% if activeFonts %}
        {# Wir prüfen, ob variable Fonts vorhanden sind. Wenn ja, nutzen wir nur diese, sonst die statischen. #}
        {% set varFonts = activeFonts | selectattr("isVariable") | list %}
        {% set displayFonts = varFonts if varFonts | length > 0 else activeFonts %}

        <article>
            <h2>{{ selectedFontFolder }} Family</h2>

            {% for font in displayFonts %}

                {# Variable Schriften #}
                {% if font.isVariable %}
                <small>
                    {{ font.displayName }} ({{ font.weight }}, {{ font.style }})
                    <span class="badge--variable" title="Variable Font">VAR</span>
                </small>
                <p
                    {% if font.optical %} class="{{ font.optical | slugify }}"{% endif %}
                    style="font-family: '{{ font.family }}{% if font.optical %} {{ font.optical }}{% endif %}'; font-weight: {{ font.weight }}; font-style: {{ font.style }};">
                    {{ site.panagram }}
                </p>

                {# Statische Schriften #}
                {% else %}
                <small>
                    {{ font.displayName }} ({{ font.weight }}, {{ font.style }})
                </small>
                <p
                    {% if font.optical %} class="{{ font.optical | slugify }}"{% endif %}
                    style="font-family: '{{ font.family }}{% if font.optical %} {{ font.optical }}{% endif %}'; font-weight: {{ font.weight }}; font-style: {{ font.style }};">
                    {{ site.panagram }}
                </p>
                {% endif %}

            {% endfor %}

        </article>
        {% else %}
        <p>Keine Schriften im Ordner "{{ selectedFontFolder }}" gefunden.</p>
        {% endif %}
    </section>


    <section class="ascii">
      {#
      | Unicode Range |  Dezimal  |        Inhalt        |
      | ------------- | --------- | -------------------- |
      | U+0020–U+007E | 32–126    | Basis ASCII          |
      | U+00A0–U+00FF | 160–255   | Latein-1 (ü, é, ñ …) |
      | U+0100–U+017F | 256–383   | Latein Erweitert-A   |
      | U+0180–U+024F | 384–591   | Latein Erweitert-B   |
      | U+0400–U+04FF | 1024–1279 | Kyrillisch           |
      | U+0600–U+06FF | 1536–1791 | Arabisch             |
      #}

      <h2>Basic ASCII</h2>
      {% for i in range(33, 126) %}
      <span class="l">{{ i | chr }}</span>
      {% endfor %}

      <h2>Latin-1</h2>
      {% for i in range(160, 255) %}
      <span class="l">{{ i | chr }}</span>
      {% endfor %}

      <h2>Latein Erweitert-A</h2>
      {% for i in range(256, 383) %}
      <span class="l">{{ i | chr }}</span>
      {% endfor %}

      <h2>Latein Erweitert-B</h2>
      {% for i in range(348, 591) %}
      <span class="l">{{ i | chr }}</span>
      {% endfor %}

    </section>

</div>
