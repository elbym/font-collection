<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {# ── Computed SEO variables ────────────────────────────────── #}
  {%- if folder -%}
    {%- if folder.isLeaf -%}
      {%- set pageTitle = folder.title + " | " + site.title -%}
      {%- set pageDesc = "Specimen page for " + folder.title
        + ((" — a " + (folder.tags | join(", ")) + " typeface") if folder.tags.length else "")
        + ((" by " + folder.fontauthor) if folder.fontauthor else "") + "." -%}
      {%- set ogType = "article" -%}
      {%- set robotsContent = "index, follow" -%}
    {%- else -%}
      {%- set pageTitle = folder.title + " Fonts | " + site.title -%}
      {%- set pageDesc = "Browse " + folder.title + " fonts in this personal font collection." -%}
      {%- set ogType = "website" -%}
      {%- set robotsContent = "index, follow" -%}
    {%- endif -%}
  {%- elif tag -%}
    {%- set pageTitle = "Tag: " + tag + " | " + site.title -%}
    {%- set pageDesc = 'Browse all fonts tagged "' + tag + '" in this personal font collection.' -%}
    {%- set ogType = "website" -%}
    {%- set robotsContent = "noindex, follow" -%}
  {%- else -%}
    {%- set pageTitle = (title + " | " + site.title) if title else site.title -%}
    {%- set pageDesc = description or site.description -%}
    {%- set ogType = "website" -%}
    {%- set robotsContent = "index, follow" -%}
  {%- endif -%}
  {%- set pageUrl = site.url + page.url -%}
  {%- set pageColor = folder.color if (folder and folder.color) else site.color -%}

  <title>{{ pageTitle }}</title>

  {# ── Core SEO ──────────────────────────────────────────────── #}
  <meta name="description" content="{{ pageDesc }}">
  <meta name="author" content="{{ site.author }}">
  <meta name="robots" content="{{ robotsContent }}">
  <link rel="canonical" href="{{ pageUrl }}">

  {# ── Language ──────────────────────────────────────────────── #}
  <meta http-equiv="Content-Language" content="de">

  {# ── OG image: per-font background for leaf pages, static fallback otherwise ── #}
  {%- set _ogImagePath = "/img/og_preview.png" -%}
  {%- set _ogImageIsStatic = true -%}
  {%- if folder and folder.isLeaf -%}
    {%- set _fontBgs = fontBackgrounds[folder.key] if fontBackgrounds else [] -%}
    {%- if _fontBgs and (_fontBgs | length) > 0 -%}
      {%- set _ogImagePath = _fontBgs[0] -%}
      {%- set _ogImageIsStatic = false -%}
    {%- endif -%}
  {%- endif -%}

  {# ── Open Graph ────────────────────────────────────────────── #}
  <meta property="og:type" content="{{ ogType }}">
  <meta property="og:locale" content="de_DE">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:image" content="{{ site.url }}{{ _ogImagePath | url }}">
  {% if _ogImageIsStatic %}<meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">{% endif %}

  {# ── Twitter Card ──────────────────────────────────────────── #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDesc }}">
  <meta name="twitter:image" content="{{ site.url }}{{ _ogImagePath | url }}">

  {# ── Theme color ───────────────────────────────────────────── #}
  <meta name="theme-color" content="{{ folder.colorHex or site.colorHex }}">

  {# ── Stylesheets ───────────────────────────────────────────── #}
  <link rel="stylesheet" href="/css/styles.css">

  {% if folder.isLeaf %}
  <link rel="stylesheet" href="/css/webfonts/{{ folder.key | slugify }}.css">
  {% endif %}

  <script src="/js/font-lazy-loader.js" defer></script>
  <script src="/js/compare-manager.js" defer></script>
  <script src="/js/font-search.js" defer></script>
  <script src="/js/font-style-hover.js" defer></script>

  {% if folder %}
  <style>
    :root {
        {% if folder.color %}--color-base-primary: {{ folder.color }};{% endif %}
    }
  </style>
  <script>
    (function(){
      var r = function(){ return Math.floor(Math.random() * 219) + 120; };
      document.documentElement.style.setProperty('--hue-offset-2', r());
      document.documentElement.style.setProperty('--hue-offset-3', r());
    })();
  </script>
  {% endif %}

  {% if extra_css %}
    <link rel="stylesheet" href="{{ extra_css }}">
  {% endif %}

  {# ── Icons ─────────────────────────────────────────────────── #}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.ico" sizes="any">

  {# ── BreadcrumbList Structured Data ───────────────────────── #}
  {% if folder %}
  {%- set _bcAncestors = folder | getAncestors(fontFolders) -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "{{ site.title | jsonEscape }}",
        "item": "{{ site.url }}/font-collection/"
      }{% if _bcAncestors.length %},
      {
        "@type": "ListItem",
        "position": 2,
        "name": "{{ _bcAncestors[0].title | jsonEscape }}",
        "item": "{{ site.url }}/font-collection/{{ _bcAncestors[0].url }}.html"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "{{ folder.title | jsonEscape }}",
        "item": "{{ pageUrl }}"
      }{% else %},
      {
        "@type": "ListItem",
        "position": 2,
        "name": "{{ folder.title | jsonEscape }}",
        "item": "{{ pageUrl }}"
      }{% endif %}
    ]
  }
  </script>
  {% endif %}

  {# ── JSON-LD Structured Data ───────────────────────────────── #}
  {% if folder and folder.isLeaf %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "{{ folder.title }}",
    "description": "{{ pageDesc | jsonEscape }}",
    "url": "{{ pageUrl }}"{% if folder.fontauthor %},
    "author": {
      "@type": "Person",
      "name": "{{ folder.fontauthor }}"
    }{% endif %}{% if folder.fontyear %},
    "dateCreated": "{{ folder.fontyear }}"{% endif %}{% if folder.tags.length %},
    "keywords": [{% for t in folder.tags %}"{{ t | jsonEscape }}"{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}{% if folder.sourceUrl %},
    "sameAs": "{{ folder.sourceUrl }}"{% endif %}
  }
  </script>
  {% elif not folder and not tag %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ site.title }}",
    "description": "{{ site.description }}",
    "url": "{{ site.url }}"
  }
  </script>
  {% else %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "{{ pageTitle }}",
    "description": "{{ pageDesc | jsonEscape }}",
    "url": "{{ pageUrl }}"
  }
  </script>
  {% endif %}
</head>

<body class="{% if folder %}specimen font-{{ folder.key | slugify }}{% endif %}"{% if (folder and not folder.isLeaf) or tag %} data-pagefind-ignore="all"{% endif %}>

  {# <div class="container"> #}

  {% include "header.njk" %}

  {% if not folder and not tag %}
  <article class="content">
    {{ content | safe }}
  </article>
  {% else %}
  {{ content | safe }}
  {% endif %}

  {% include "footer.njk" %}

  {# </div> #}

</body>
</html>
