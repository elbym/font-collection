<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ folder.title or title or site.title }}</title>
  <meta name="description" content="{{ folder.description or site.description or 'A personal collection of free and open-source fonts with detailed specimen pages.' }}">
  <link rel="stylesheet" href="/css/styles.css">

  {% if folder.key is defined %}
  <link rel="stylesheet" href="/css/webfonts/all-fonts.css">
  {% endif %}

  {% if folder.color %}
  <style>
    :root {
        --color-base-primary: {{ folder.color }};
    }
  </style>
  {% endif %}

  {% if extra_css %}
    <link rel="stylesheet" href="{{ extra_css }}">
  {% endif %}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.ico" sizes="any">
</head>

<body class="specimen font-{{ folder.key | slugify }}">

  <div class="container">

  {% include "header.njk" %}

  <main>
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}

  </div>
</body>
</html>
