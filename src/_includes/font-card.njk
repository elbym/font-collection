{# Erwartet 'node' aus fontFolders (z. B. aus der index.njk-Schleife
   oder beim Einbinden von Gruppenübersichten in specimen.njk) #}

{% set _title    = node.title %}
{% set _url      = "/" + node.url + ".html" %}
{% set _heroText = node.heroword or site.heroword %}
{% set _color    = node.color or site.color %}
{% set _tags     = node.tags if node.tags.length else [] %}

{% set _hasItalic = node.ownFonts | selectattr("style", "equalto", "italic") | list | length > 0 %}
<article class="card font-{{ node.key | slugify }} flex flex-col justify-between rounded-lg w-full"
  data-font-slug="{{ node.key | slugify }}"
  data-name="{{ node.title | lower }}"
  data-category="{{ node.category | slugify }}"
  data-variable="{{ 'true' if (node.varAxes and node.varAxes.length > 0) else '' }}"
  data-italic="{{ 'true' if _hasItalic else '' }}"
  data-favorite="{{ 'true' if node.favorite else '' }}"
  data-styles="{{ node.ownFonts | length }}"
  data-year="{{ node.fontyear or '' }}">
  {# Prefer per-font backgrounds from `fontBackgrounds`, fallback to global `backgrounds` #}
  {% set fontBg = fontBackgrounds[node.key] if (fontBackgrounds and fontBackgrounds[node.key]) else [] %}
  {% set bgList = fontBg if (fontBg and (fontBg | length) > 0) else backgrounds %}
  {% set _family = node.ownFonts[0].family if node.ownFonts.length else node.title %}
  <header
    class="rounded-t-lg grow flex relative overflow-hidden"
    {% if bgList and bgList.length > 0 %}style="background-image: url('{{ bgList | random | url }}');"{% endif %}
    >
    <a href="{{ _url }}" class="color-{{ _color | slugify }} flex flex-col justify-center w-full relative no-underline">
      <h3
        data-hover-styles="{% for f in node.ownFonts %}{% if not loop.first %},{% endif %}{{ f.weight }}{{ 'i' if f.style == 'italic' else 'n' }}{% endfor %}"
        data-font-family="{{ _family }}">{{ _title }}</h3>
    </a>
    {% if node.favorite %}
    <span class="favorite-star" title="Must have font" aria-label="Favorit">★</span>
    {% endif %}
    <button class="compare-toggle"
      aria-pressed="false"
      title="Zum Vergleich hinzufügen"
      data-slug="{{ node.key | slugify }}"
      data-title="{{ node.title }}"
      data-family="{{ _family }}"
      data-url="{{ node.url }}">+</button>
  </header>

  <main class="bg-(--color-surface) p-4">
    <p class="letters">Aa Rr Ee</p>
    <p class="letters italic">Aa Rr Ee</p>

    <p class="display-size-2 heroword ligature color-{{ _color | slugify }} py-4 font-semibold text-right">{{ _heroText }}</p>
    <p class="display-size-2 numbers text-right old-nums">0123456789</p>
  </main>
  {% set _cpMap = fontCodepoints[node.key] if fontCodepoints else null %}
  {% if _cpMap %}
  <div class="card-coverage">
    {% for section in unicodeRanges %}
      {% set pct = section.key | coveragePercent(_cpMap) %}
      <span class="cov-item{% if pct == 0 %} cov-zero{% endif %}" title="{{ section.label }}: {{ pct }}%">
        <span class="cov-label">{{ section.short }}</span>
        <span class="cov-pct">{{ pct }}%</span>
      </span>
    {% endfor %}
  </div>
  {% endif %}
  {% if _tags.length %}
  <footer class="rounded-b-lg py-2 px-4" style="background: color-mix(in oklab, {{ _color }}, transparent 50%);">
    <ul class="keywords small ligatures">
      {% for tag in _tags %}
        <li><a class="text-(--color-text) no-underline" href="/tag/{{ tag | slugify }}.html">{{ tag }}</a></li>
      {% endfor %}
    </ul>
  </footer>
  {% endif %}
</article>
