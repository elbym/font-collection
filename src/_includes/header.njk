<header data-pagefind-ignore>
  <nav aria-label="Hauptnavigation">

    {# ── Rekursives Makro für Font-Nodes ──────────────────────── #}
    {%- macro renderFontNode(node, fontFolders, currentFolder) -%}
      {%- set children = node | getChildNodes(fontFolders) -%}
      {%- set isActive   = currentFolder and (node.path == currentFolder.path) -%}
      {%- set isAncestor = currentFolder and (node | isAncestorOf(currentFolder)) -%}
      {%- set isOpen = isActive or isAncestor -%}
      <li class="
        {%- if isActive %}is-active {%- endif %}
        {%- if isAncestor %}is-ancestor {%- endif %}
        {%- if children.length %}has-children{%- endif %}
      ">
        <a href="/{{ node.url }}.html"
          {%- if isActive %} aria-current="page"{% endif %}
          {%- if children.length %} aria-expanded="{{ 'true' if isOpen else 'false' }}"{% endif %}
          {%- if node.color %} style="color: {{ node.color }}"{% endif %}>
          {{ node.title }}
        </a>
        {%- if children.length and isOpen -%}
          <ul aria-label="{{ node.title }}">
            {%- for child in children -%}
              {{ renderFontNode(child, fontFolders, currentFolder) }}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </li>
    {%- endmacro -%}

    <ul class="primary">

      {# ── Manuelle Seiten (index.njk, alternativen.njk …) ─────── #}
      {% set manualPages = collections.all | getManualNav %}
      {%- for entry in manualPages %}
        <li{% if entry.url == page.url %} class="is-active"{% endif %}>
          <a href="{{ entry.url }}"
            {%- if entry.url == page.url %} aria-current="page"{% endif %}>
            {{ entry.title }}
          </a>
        </li>
      {%- endfor %}

      {# ── Fonts-Gruppe ─────────────────────────────────────────── #}
      {%- set fontRoots = fontFolders | getRootNodes -%}
      {%- if fontRoots.length %}
        <li class="nav-group
          {%- if folder %} is-open{%- endif %}">
          <ul aria-labelledby="nav-group-fonts">
            {%- for node in fontRoots -%}
              {{ renderFontNode(node, fontFolders, folder) }}
            {%- endfor -%}
          </ul>
        </li>
      {%- endif %}

    </ul>

    <form
      role="search"
      class="font-search"
      aria-label="Schriften suchen"
      data-pagefind-url="{{ '/pagefind/pagefind.js' | url }}"
      data-search-url="{{ '/search.html' | url }}"
    >
      <input
        type="search"
        id="font-search-input"
        name="q"
        placeholder="Schrift suchen …"
        autocomplete="off"
        spellcheck="false"
        aria-label="Schrift suchen"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-haspopup="listbox"
        aria-controls="font-search-results"
      >
      <ul id="font-search-results" role="listbox" aria-label="Suchergebnisse" hidden></ul>
    </form>

  </nav>
</header>
