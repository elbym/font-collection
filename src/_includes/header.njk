<header>
<nav>
    <ul class="primary">
      {% set navPages = collections.all | eleventyNavigation %}

      {% for entry in navPages | sort(false, false, 'family') %}
        <li{% if entry.url == page.url %} class="active"{% endif %}>
          <a href="{{ entry.url }}#poster">{{ entry.title }}</a>
        </li>
      {% endfor %}
    </ul>

  </nav>
</header>