{% from "nav.njk" import navTree %}

{# Flat nav item list — manual eleventyNavigation pages, then the font-category
   roots with their leaf children. Built by getNavItems (.eleventy.js) from the
   fonts.js data layer and getManualNav; nothing is hardcoded here. #}
{%- set navItems = fontFolders | getNavItems(collections.all | getManualNav, folder, page.url) -%}

<header data-pagefind-ignore>
  <div class="relative flex items-center justify-between gap-4 py-2">
    <nav aria-label="Hauptnavigation" class="min-w-0">
      {{ navTree(navItems) }}
    </nav>

    <form
      role="search"
      class="font-search smaller"
      aria-label="Schriften suchen"
      data-pagefind-url="{{ '/pagefind/pagefind.js' | url }}"
      data-search-url="{{ '/search.html' | url }}"
    >
      <input
        type="search"
        id="font-search-input"
        name="q"
        placeholder="Schrift suchen …"
        autocomplete="off"
        spellcheck="false"
        aria-label="Schrift suchen"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-haspopup="listbox"
        aria-controls="font-search-results"
      >
      <ul id="font-search-results" role="listbox" aria-label="Suchergebnisse" hidden></ul>
    </form>
  </div>
</header>
