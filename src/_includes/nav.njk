{# ── Navigation component ─────────────────────────────────────────────────
   Two entry points, both driven by the same `items` list built in header.njk:
     navDesktop(items) — horizontal bar with hover/focus dropdowns (md and up)
     navMobile(items)  — off-canvas accordion panel (below md)
   `items` is a list of { type: "link", url, title } or
   { type: "group", node, children, isOpen } produced by header.njk from the
   font data layer (fontFolders) and from eleventyNavigation frontmatter
   (getManualNav) — nothing here is hardcoded.
─────────────────────────────────────────────────────────────────────────── #}

{%- macro navDesktop(items) -%}
  <ul class="nav-bar hidden md:flex items-center gap-1">
    {%- for item in items %}
      {%- if item.type == "link" %}
        <li>
          <a class="nav-link" href="{{ item.url }}"
            {%- if item.isActive %} aria-current="page"{% endif %}>
            {{ item.title }}
          </a>
        </li>
      {%- else %}
        <li class="group relative">
          <a class="nav-link inline-flex items-center gap-1" href="/{{ item.node.url }}.html"
            {%- if item.isActive %} aria-current="page"{% endif %}
            aria-haspopup="true" aria-expanded="false"
            {%- if item.node.color %} style="color: {{ item.node.color }}"{% endif %}>
            {{ item.node.title }}
            <svg class="size-3 shrink-0 transition-transform duration-200 ease-out group-hover:rotate-180 group-focus-within:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M2.5 4.5 6 8l3.5-3.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <ul aria-label="{{ item.node.title }}"
            class="nav-dropdown invisible absolute left-0 top-full z-20 mt-1 w-max max-w-[min(90vw,40rem)] columns-2 gap-x-4 opacity-0 -translate-y-1 transition duration-150 ease-out group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0
              {%- if item.isOpen %} md:visible md:opacity-100 md:translate-y-0{% endif %}">
            {%- for child in item.children %}
              <li class="break-inside-avoid">
                <a class="nav-link block text-sm" href="/{{ child.url }}.html"
                  {%- if child.isActive %} aria-current="page"{% endif %}>
                  {{ child.title }}
                </a>
              </li>
            {%- endfor %}
          </ul>
        </li>
      {%- endif %}
    {%- endfor %}
  </ul>
{%- endmacro -%}

{%- macro navMobile(items) -%}
  <div id="mobile-nav-panel" class="mobile-nav fixed inset-0 z-40 hidden md:hidden" role="dialog" aria-modal="true" aria-label="Hauptnavigation" data-state="closed">
    <div class="mobile-nav__backdrop absolute inset-0 bg-(--color-base-shadow)" data-nav-close></div>
    <div class="mobile-nav__sheet absolute inset-y-0 right-0 flex w-[85vw] max-w-sm translate-x-full flex-col overflow-y-auto bg-(--color-background) p-4 shadow-xl transition-transform duration-200 ease-out">
      <div class="flex items-center justify-between pb-2">
        <span class="font-semibold text-(--color-text)">Menü</span>
        <button type="button" class="nav-icon-btn" data-nav-close aria-label="Menü schließen">
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <ul class="flex flex-col gap-1">
        {%- for item in items %}
          {%- if item.type == "link" %}
            <li>
              <a class="nav-link block" href="{{ item.url }}"
                {%- if item.isActive %} aria-current="page"{% endif %}>
                {{ item.title }}
              </a>
            </li>
          {%- else %}
            <li class="border-t border-(--color-border) pt-1 first:border-t-0 first:pt-0">
              <div class="flex items-center">
                <a class="nav-link flex-1" href="/{{ item.node.url }}.html"
                  {%- if item.isActive %} aria-current="page"{% endif %}>
                  {{ item.node.title }}
                </a>
                <button type="button" class="nav-icon-btn group" data-nav-accordion-toggle aria-expanded="{{ 'true' if item.isOpen else 'false' }}" aria-controls="mobile-group-{{ loop.index }}" aria-label="{{ item.node.title }} Untermenü umschalten">
                  <svg class="size-4 shrink-0 transition-transform duration-200 ease-out group-aria-expanded:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M2.5 4.5 6 8l3.5-3.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
              <ul id="mobile-group-{{ loop.index }}" class="{% if not item.isOpen %}hidden{% endif %} flex flex-col gap-0.5 py-1 pl-3">
                {%- for child in item.children %}
                  <li>
                    <a class="nav-link block text-sm" href="/{{ child.url }}.html"
                      {%- if child.isActive %} aria-current="page"{% endif %}>
                      {{ child.title }}
                    </a>
                  </li>
                {%- endfor %}
              </ul>
            </li>
          {%- endif %}
        {%- endfor %}
      </ul>
    </div>
  </div>
{%- endmacro -%}
