{# ── Navigation ──────────────────────────────────────────────────────────
   One markup tree for every breakpoint, no JavaScript.

   Outer  <details class="site-nav">  — below md the <summary> is a hamburger
   that toggles the menu; at md+ the <summary> is hidden and the list is
   forced visible via CSS (src/css/tailwind.css), rendering as a bar.

   Nested <details class="nav-group">  — one per font category. Native
   click / Enter / Space toggle on every breakpoint; at md+ the open panel
   is positioned as an absolute dropdown. `name="nav-group"` makes the
   categories behave as an exclusive accordion where supported.

   `items` comes from the getNavItems filter (.eleventy.js): manual
   eleventyNavigation pages first, then the font-category roots with their
   leaf children. Nothing is hardcoded here.
──────────────────────────────────────────────────────────────────────── #}
{%- macro navTree(items) -%}
<details class="site-nav">
  <summary class="nav-link inline-flex w-fit items-center gap-2 md:hidden" aria-label="Hauptmenü">
    <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
      <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"/>
    </svg>
    Menü
  </summary>

  <ul class="site-nav__list absolute inset-x-0 top-full z-30 mt-2 flex flex-col gap-1 rounded-md border border-(--color-border) bg-(--color-surface) p-2 shadow-lg md:relative md:mt-0 md:flex-row md:flex-wrap md:items-center md:gap-1 md:rounded-none md:border-0 md:bg-transparent md:p-0 md:shadow-none">
    {%- for item in items %}
      {%- if item.type == "link" %}
        <li>
          <a class="nav-link block" href="{{ item.url }}"{% if item.isActive %} aria-current="page"{% endif %}>{{ item.title }}</a>
        </li>
      {%- else %}
        <li class="nav-group">
          <details class="nav-group__d" name="nav-group"{% if item.isOpen %} open{% endif %}>
            <summary class="nav-link flex items-center justify-between gap-2 md:justify-start"{% if item.isActive %} aria-current="page"{% endif %}{% if item.node.color %} style="color: {{ item.node.color }}"{% endif %}>
              {{ item.node.title }}
              <svg class="nav-chevron size-3 shrink-0 transition-transform duration-200 ease-out" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M2.5 4.5 6 8l3.5-3.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>

            <ul aria-label="{{ item.node.title }}" class="mt-1 flex flex-col gap-0.5 pl-3 md:absolute md:inset-x-0 md:top-full md:z-30 md:mt-1 md:block md:columns-[9rem] md:gap-x-6 md:rounded-md md:border md:border-(--color-border) md:bg-(--color-surface) md:p-3 md:pl-3 md:shadow-lg">
              <li class="md:break-inside-avoid">
                <a class="nav-link block text-xs italic" href="/{{ item.node.url }}.html"{% if item.isActive %} aria-current="page"{% endif %}>Alle {{ item.node.title }}</a>
              </li>
              {%- for child in item.children %}
                <li class="md:break-inside-avoid">
                  <a class="nav-link block text-xs" href="/{{ child.url }}.html"{% if child.isActive %} aria-current="page"{% endif %}>{{ child.title }}</a>
                </li>
              {%- endfor %}
            </ul>
          </details>
        </li>
      {%- endif %}
    {%- endfor %}
  </ul>
</details>
{%- endmacro -%}
