{
  "name": "font-collection",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "eleventy && node scripts/subset-fonts.js && npm run css && npm run js && node scripts/set-base.js && node scripts/font-pages.js",
    "build:pages": "BASE_PATH=/font-collection/ npm run build",
    "css": "tailwindcss -i src/css/tailwind.css -o _site/tailwind.css --minify",
    "dev": "node scripts/dev.js",
    "deploy": "npm run build:pages && cd _site && git init -q && git add -A && git commit -qm deploy && git push \"$(git -C .. remote get-url origin)\" HEAD:gh-pages --force",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "clean": "rm -rf _site",
    "js": "node scripts/build-js.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.2",
    "chroma-js": "^3.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "fontkit": "^2.0.4",
    "globals": "^17.13.0",
    "js-yaml": "^4.2.0",
    "prettier": "^3.9.10",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
